<!-- TODO MathJax responsive patch -->
<script type="text/javascript">

  /* List of fixable exercises */
  var MathJaxEXE = [
    {
      exeName: '.eke-filltable-dnd',
      targetName: '.answer-div'
    },
    {
      exeName: '.wm-dnd-item-to-area',
      targetName: '.answer-item'
    },
    {
      exeName: '.eke-pairing-drag-and-drop',
      targetName: '.answer-div'
    },
    {
      exeName: '.eke-quiz-series',
      targetName: '.exe-quiz-question'
    },
    {
      exeName: '.eke-quiz-series',
      targetName: '.button'
    }

  ];

</script>


<script>
  lightbox.option({
    'resizeDuration': 200,
    'wrapAround': true,
    'albumLabel': "%1 / %2 kép",
    'zoomistEnable': true
  });

  MathJax = {
    tex: {
      inlineMath: [
        ['$', '$'],
        ["\\(", "\\)"]
      ],
      digits: /^(?:[0-9]+(?:\{,\}[0-9]{3})*(?:,[0-9]*)?|,[0-9]+)/,
      displayMath: [ ['$$','$$'] ],
      processEscapes: true,
      processEnvironments: true,
      /*
       autoload: {
       color: [],
       colorv2: ['color']
       },
       */
      packages: {'[+]': ['noerrors']}
    },
    options: {
      menuOptions: {
        settings: {
          zoom: "DoubleClick",
          speech: false,
          braille: false
        }
      },
      enableMenu: true,
      ignoreHtmlClass: 'tex2jax_ignore',
      processHtmlClass: 'tex2jax_process'
    },
    asciimath: {
      delimiters: [['\\$', '\\$']]
    },
    chtml: {
      //scale: 0.85,
      matchFontHeight: false,
      merrorFont: 'OpenSansSemiBold',
      unknownFamily: 'OpenSansSemiBold'
    },
    startup: {
      ready() {
        MathJax.startup.defaultReady();
        let menu = MathJax.startup.document.menu.menu;
        menu._items.forEach((item) => {
          if (item._type != 'command') {
            item.hidden = true;
          }
        });
        menu._items.forEach((item) => {
          switch(item._content) {
            case 'About MathJax':
              item._content = 'A MathJax-ról';
              break;
            case 'MathJax Help':
              item._content = 'MathJax Segítség';
              break;
            default:
                  // code block
          }
        });
      }
    }

  }

</script>

<!-- script type="text/javascript" id="MathJax-script" async src="/lib/mathjax/3.2.2/es5/tex-chtml-full.js"></script -->

<script type="text/javascript">
  if (location.search.includes("mathjax=4")) {
    document.write('<script type="text/javascript" id="MathJax-script-4" async src="/lib/mathjax-4/tex-chtml.js"><\/script>');
  } else {
    document.write('<script type="text/javascript" id="MathJax-script" async src="/lib/mathjax/es5/tex-chtml-full.js"><\/script>');
  }
</script>






